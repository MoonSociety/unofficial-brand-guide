{
  "$schema": "https://design-tokens.github.io/community-group/format/",
  "$description": "The Moon Society design tokens (unofficial) — W3C Design Tokens Community Group format. Use with style-dictionary or any compatible tool to generate CSS, SCSS, iOS, Android, etc.",
  "color": {
    "primary": {
      "spaceCadet": { "$value": "#13294B", "$type": "color", "$description": "Space Cadet Blue — primary background, dominant brand color" },
      "gold":       { "$value": "#FFCD00", "$type": "color", "$description": "Gold — primary accent, CTAs, highlights" }
    },
    "secondary": {
      "cerulean": { "$value": "#00A3E0", "$type": "color", "$description": "Links, interactive elements" },
      "blue":     { "$value": "#006298", "$type": "color", "$description": "Mid-tone blue for depth" },
      "cyan":     { "$value": "#6AD1E3", "$type": "color", "$description": "Light accent, data viz, tags" },
      "emerald":  { "$value": "#009775", "$type": "color", "$description": "Success, positive indicators" }
    },
    "neutral": {
      "white":     { "$value": "#FFFFFF", "$type": "color" },
      "gray100":   { "$value": "#D0D0CE", "$type": "color", "$description": "Cool Gray 2" },
      "gray200":   { "$value": "#B1B3B3", "$type": "color", "$description": "Cool Gray 5" },
      "gray300":   { "$value": "#888B8D", "$type": "color", "$description": "Cool Gray 8" },
      "gray400":   { "$value": "#53565A", "$type": "color", "$description": "Cool Gray 11" },
      "nearBlack": { "$value": "#1D252D", "$type": "color", "$description": "Deep background" },
      "black":     { "$value": "#000000", "$type": "color" }
    },
    "semantic": {
      "success": { "$value": "#009775", "$type": "color" },
      "warning": { "$value": "#D29F13", "$type": "color" },
      "error":   { "$value": "#E84855", "$type": "color" }
    }
  },
  "font": {
    "family": {
      "display":   { "$value": "Syne",          "$type": "fontFamily" },
      "heading":   { "$value": "League Spartan", "$type": "fontFamily" },
      "body":      { "$value": "Noto Sans",      "$type": "fontFamily" },
      "serif":     { "$value": "Palatino",       "$type": "fontFamily" },
      "monospace": { "$value": "Inconsolata",    "$type": "fontFamily" }
    },
    "weight": {
      "regular":   { "$value": 400, "$type": "fontWeight" },
      "medium":    { "$value": 500, "$type": "fontWeight" },
      "semibold":  { "$value": 600, "$type": "fontWeight" },
      "bold":      { "$value": 700, "$type": "fontWeight" },
      "extrabold": { "$value": 800, "$type": "fontWeight" }
    },
    "lineHeight": {
      "tight":   { "$value": 1.2,  "$type": "number" },
      "normal":  { "$value": 1.5,  "$type": "number" },
      "relaxed": { "$value": 1.65, "$type": "number" }
    }
  },
  "size": {
    "fontBase":     { "$value": "16px", "$type": "dimension" },
    "fontMinBody":  { "$value": "14px", "$type": "dimension" },
    "maxLineWidth": { "$value": "65ch", "$type": "dimension" }
  },
  "space": {
    "1":  { "$value": "0.25rem", "$type": "dimension" },
    "2":  { "$value": "0.5rem",  "$type": "dimension" },
    "3":  { "$value": "0.75rem", "$type": "dimension" },
    "4":  { "$value": "1rem",    "$type": "dimension" },
    "5":  { "$value": "1.5rem",  "$type": "dimension" },
    "6":  { "$value": "2rem",    "$type": "dimension" },
    "7":  { "$value": "3rem",    "$type": "dimension" },
    "8":  { "$value": "4rem",    "$type": "dimension" },
    "9":  { "$value": "6rem",    "$type": "dimension" },
    "10": { "$value": "8rem",    "$type": "dimension" }
  },
  "radius": {
    "sm":   { "$value": "4px",    "$type": "dimension" },
    "md":   { "$value": "8px",    "$type": "dimension" },
    "lg":   { "$value": "12px",   "$type": "dimension" },
    "xl":   { "$value": "16px",   "$type": "dimension" },
    "full": { "$value": "9999px", "$type": "dimension" }
  }
}
